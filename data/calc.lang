<?xml version="1.0" encoding="UTF-8"?>
<!-- QuickNotes calculation sheets (see src/calc.rs and data/help.md). -->
<language id="calc" name="Calculation" version="2.0" section="Other">
  <metadata>
    <property name="globs">*.calc</property>
    <property name="line-comment-start">#</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="template" name="Template" map-to="def:string"/>
    <style id="template-marker" name="Template marker" map-to="def:keyword"/>
    <style id="template-expr" name="Template expression" map-to="def:preprocessor"/>
    <style id="escape" name="Escape" map-to="def:special-char"/>
    <style id="variable" name="Variable" map-to="def:type"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="function" name="Function" map-to="def:function"/>
    <style id="constant" name="Constant" map-to="def:special-constant"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
  </styles>

  <definitions>
    <context id="calc">
      <include>
        <context id="template" style-ref="template" end-at-line-end="true">
          <start>^\s*(&gt;)</start>
          <include>
            <context sub-pattern="1" where="start" style-ref="template-marker"/>
            <context id="template-expr" style-ref="template-expr">
              <start>\{</start>
              <end>\}</end>
            </context>
            <context id="escape" style-ref="escape">
              <match>\\.</match>
            </context>
          </include>
        </context>
        <context id="comment" style-ref="comment" end-at-line-end="true" class="comment">
          <start>#|//</start>
        </context>
        <context id="assignment">
          <match>^\s*([\p{L}_][\p{L}\p{N}_]*)\s*(?==(?!=))</match>
          <include>
            <context sub-pattern="1" style-ref="variable"/>
          </include>
        </context>
        <context id="number" style-ref="number">
          <match>(?&lt;![\p{L}_])\d+(\.\d+)?|\.\d+</match>
        </context>
        <context id="functions" style-ref="function">
          <keyword>sqrt</keyword><keyword>abs</keyword><keyword>round</keyword>
          <keyword>floor</keyword><keyword>ceil</keyword><keyword>trunc</keyword>
          <keyword>int</keyword><keyword>min</keyword><keyword>max</keyword>
          <keyword>sum</keyword><keyword>avg</keyword><keyword>sin</keyword>
          <keyword>cos</keyword><keyword>tan</keyword><keyword>asin</keyword>
          <keyword>acos</keyword><keyword>atan</keyword><keyword>rad</keyword>
          <keyword>deg</keyword><keyword>ln</keyword><keyword>log</keyword>
          <keyword>log2</keyword><keyword>exp</keyword><keyword>qs</keyword>
          <keyword>digitsum</keyword><keyword>iqs</keyword><keyword>digitroot</keyword>
        </context>
        <context id="constants" style-ref="constant">
          <keyword>pi</keyword>
        </context>
        <context id="operator" style-ref="operator">
          <match>[-+*/%^!=×÷·−]</match>
        </context>
      </include>
    </context>
  </definitions>
</language>
