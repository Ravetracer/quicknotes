#!/bin/sh
# Bundled PlantUML: Java runtime, PlantUML (MIT edition) and Graphviz.
HERE="$(dirname "$(readlink -f "$0")")"
export GRAPHVIZ_DOT="$HERE/dot"
export GVBINDIR="$HERE/../lib/graphviz"
exec "$HERE/../lib/jvm/bin/java" -Djava.awt.headless=true -jar "$HERE/../share/plantuml/plantuml.jar" "$@"
